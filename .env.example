# Server Configuration
BASE_URL=http://localhost:3000
PORT=3000
CORS_ORIGIN=*
DEV_FRONTEND_URL=http://localhost:3001

# Database Configuration
DATABASE_DIR=.autocator-data

# Crypto Configuration
PRIVATE_KEY=your_private_key_here
ALLOCATOR_ADDRESS=signing_address_or_contract_address
SIGNING_ADDRESS=derived_from_private_key

# External Services - Indexers
# The Compact V1 Indexer (for balances, claims, registrations)
INDEXER_URL=https://the-compact-v1-indexer.marble.live
# Hybrid Allocator Indexer (for allocations, signers, attestations)
HYBRID_ALLOCATOR_INDEXER_URL=https://hybrid-allocator-indexer.marble.live

# Arbiter Configuration
# Tribunal is always allowed by default. Add additional allowed arbiters (comma-separated)
# ALLOWED_ARBITERS=0x1234...,0x5678...
